// North NJ Real Estate Tracker — database schema
// See CLAUDE.md for a narrative description of these models and how they're used.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// PropertyType ("SINGLE_FAMILY" | "MULTI_FAMILY" | "CONDO" | "TOWNHOUSE") and
// ListingStatus ("ACTIVE" | "PENDING" | "SOLD") are stored as plain strings
// rather than native Postgres enums, and typed at the TS layer instead (see
// src/types/listing.ts). This was originally required when the project ran
// on SQLite (no enum support there); kept as strings after the Postgres
// migration so the two engines stay schema-compatible if local dev ever
// needs to fall back to SQLite again.

// Current state of a listing. Upserted on every sync from a ListingProvider.
// Historical values live in ListingSnapshot / PriceChange so this table always
// reflects "what the market looks like right now".
model Listing {
  id        String   @id @default(cuid())
  source    String // provider key, e.g. "mock", "rentcast", "csv:redfin"
  externalId String  // id assigned by the source provider, unique per source
  address   String
  town      String
  county    String
  zip       String
  lat       Float?
  lng       Float?

  listPrice      Float
  pricePerSqft   Float
  beds           Float
  baths          Float
  sqft           Int
  lotSizeSqft    Int?
  yearBuilt      Int?
  propertyType   String
  status         String @default("ACTIVE")

  listedDate     DateTime
  soldDate       DateTime?
  soldPrice      Float?
  daysOnMarket   Int // recomputed on each sync relative to listedDate (or soldDate if sold)

  // NJ-buyer-specific extras
  hoaFee               Float? // monthly, null if none
  garageSpaces         Int?
  transitStationName   String?
  transitDistanceMiles Float? // driving distance to nearest NJ Transit / PATH station
  schoolRating         Float? // 0-10, null if data source doesn't supply it

  photoUrl String?
  url      String? // link back to source listing page

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  snapshots    ListingSnapshot[]
  priceChanges PriceChange[]

  @@unique([source, externalId])
  @@index([town])
  @@index([propertyType])
  @@index([status])
  @@index([listPrice])
  @@index([pricePerSqft])
}

// One row per listing per sync run. This is the raw material for every
// time-series chart (median price over time, DOM trends, inventory levels...)
// — aggregates are computed on read by grouping snapshots by month/town.
model ListingSnapshot {
  id           String        @id @default(cuid())
  listingId    String
  listing      Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  capturedAt   DateTime
  status       String
  listPrice    Float
  pricePerSqft Float
  daysOnMarket Int
  town         String // denormalized for fast group-by without a join
  propertyType String // denormalized for fast group-by without a join

  @@index([capturedAt])
  @@index([town, capturedAt])
  @@index([listingId])
}

// A detected price change between two consecutive syncs. Drives the "price
// cut magnitude + recency" signal in the deal-scoring engine and the price
// history shown in the listings table.
model PriceChange {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  oldPrice  Float
  newPrice  Float
  changedAt DateTime

  @@index([listingId])
  @@index([changedAt])
}

// Single-row table (id always "default") holding the tunable weights for the
// deal-scoring engine. Edited from the Settings page.
model ScoringConfig {
  id                     String   @id @default("default")
  pricePerSqftWeight     Float    @default(0.4)
  priceCutWeight         Float    @default(0.3)
  domWeight              Float    @default(0.1)
  compSalesWeight        Float    @default(0.2)
  priceCutRecencyDays    Int      @default(30)
  compSaleLookbackMonths Int      @default(12)
  updatedAt              DateTime @updatedAt
}

// Single-row table (id always "default") tracking the most recent data sync,
// whether triggered by cron/CLI (`npm run sync`) or a manual click on the
// "Refresh" button in the nav bar. Read by GET /api/sync, written by POST /api/sync.
model SyncStatus {
  id           String   @id @default("default")
  lastSyncedAt DateTime
  provider     String
  fetched      Int
  ingested     Int
}

// Single-row table (id always "default") for runtime app configuration that
// must survive without a redeploy. `rentcastApiKey` is set from the Settings
// page (write-only: the API never echoes it back) and takes precedence over
// the RENTCAST_API_KEY env var, so connecting live data is a one-time paste
// on the site itself — no Vercel dashboard or redeploy required.
// `requestsThisMonth`/`requestMonth` meter RentCast API usage so the app can
// hard-stop itself under the free tier's 50 requests/month, no matter how
// often any visitor clicks Refresh.
model AppConfig {
  id                String    @id @default("default")
  rentcastApiKey    String?
  requestsThisMonth Int       @default(0)
  requestMonth      String? // "YYYY-MM" the counter applies to; reset on rollover
  // When the last comprehensive (all-county, fully-paginated) RentCast pull
  // ran. Null means one hasn't happened yet under the current unlimited-
  // pagination code — the next daily sync escalates itself to a full pull
  // (see runSync's catch-up logic), which is how an already-deployed site
  // self-heals to complete coverage after a code upgrade, with no manual step.
  lastFullSyncAt    DateTime?
  updatedAt         DateTime  @updatedAt
}

// User-saved filter presets so common searches can be reapplied with one click.
model FilterPreset {
  id        String   @id @default(cuid())
  name      String
  filters   String // JSON-encoded ListingFilters
  createdAt DateTime @default(now())
}
