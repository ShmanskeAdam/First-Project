# Database (SQLite for local dev; swap to a Postgres URL for production)
DATABASE_URL="file:./dev.db"

# Which ListingProvider to use: "mock" (default, no key needed) or "rentcast"
LISTING_PROVIDER="mock"

# RentCast API key — required only when LISTING_PROVIDER=rentcast.
# Sign up at https://www.rentcast.io/api to get a free-tier key.
RENTCAST_API_KEY=""

# Shared secret required to call POST /api/sync (protects the manual/cron
# sync trigger from being invoked by anyone who can reach the deployment).
SYNC_SECRET="change-me"
