# Database — Postgres, both locally and in production. Get a free connection
# string from Neon (https://neon.tech) or the Vercel Postgres/Storage tab, or
# point this at a local Postgres instance (`psql` -> CREATE DATABASE ...).
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Which ListingProvider to use: "mock" (default, no key needed) or "rentcast"
LISTING_PROVIDER="mock"

# RentCast API key — required only when LISTING_PROVIDER=rentcast.
# Sign up at https://www.rentcast.io/api to get a free-tier key.
RENTCAST_API_KEY=""

# Shared secret required to call POST /api/sync with a trusted (throttle-bypassing)
# caller — protects that trigger from being spammed by anyone who can reach the deployment.
SYNC_SECRET="change-me"

# Vercel Cron authenticates itself to GET /api/cron/sync via an Authorization:
# Bearer header matching this value — Vercel reads the same env var to construct
# that header automatically, you just need to set it (any random string). Only
# relevant once deployed to Vercel with vercel.json's daily cron configured.
CRON_SECRET="change-me-too"
