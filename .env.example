# Database — Postgres, both locally and in production. Get a free connection
# string from Neon (https://neon.tech) or the Vercel Postgres/Storage tab, or
# point this at a local Postgres instance (`psql` -> CREATE DATABASE ...).
# This is the only REQUIRED variable.
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# --- Everything below is optional -------------------------------------------

# Data source. The normal way to go live is pasting a RentCast API key into
# the site's Settings page (stored in the DB, outranks these env vars, no
# redeploy needed). These exist as an env-var alternative:
#   "mock" (default) — synthetic demo data, no key needed
#   "rentcast"       — live data; also requires RENTCAST_API_KEY
#   "static"         — no-op provider (e.g. after a one-off CSV import)
LISTING_PROVIDER="mock"
RENTCAST_API_KEY=""

# Self-imposed cap on RentCast API requests per month (free tier allows 50).
# Defaults to 45. Raise it if you're on a paid RentCast plan.
RENTCAST_MONTHLY_BUDGET=""

# Lets manual/CLI POST /api/sync calls (x-sync-secret header) bypass the 30s
# public-refresh throttle.
SYNC_SECRET=""

# When set, GET /api/cron/sync requires Vercel's signed Authorization header
# (Vercel attaches it automatically from this same env var). When unset, the
# cron endpoint is open but harmless — the daily/monthly quota guards mean an
# abuser can't spend meaningful API budget.
CRON_SECRET=""
